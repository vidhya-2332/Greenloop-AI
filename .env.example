# Copy to .env for local use. Use a unique random value outside local development.
GREENLOOP_SECRET_KEY=replace-with-a-long-random-secret
GREENLOOP_HTTPS=0
# Optional: set both paths to a directory you control. Defaults keep data/greenloop.db
# and static/uploads/ in this project folder.
# GREENLOOP_DB_PATH=D:\GreenLoop-AI\data\greenloop.db
# GREENLOOP_UPLOAD_FOLDER=D:\GreenLoop-AI\static\uploads
